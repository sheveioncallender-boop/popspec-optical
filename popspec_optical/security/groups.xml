<odoo>
  <record id="privilege_optical" model="res.groups.privilege">
    <field name="name">Optical Operations</field>
    <field name="category_id" ref="base.module_category_sales"/>
  </record>
  <record id="group_operator" model="res.groups">
    <field name="name">Optical coordinator</field>
    <field name="privilege_id" ref="privilege_optical"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="group_manager" model="res.groups">
    <field name="name">Optical manager</field>
    <field name="privilege_id" ref="privilege_optical"/>
    <field name="implied_ids" eval="[(4, ref('group_operator'))]"/>
  </record>
  <record id="privilege_clinical" model="res.groups.privilege">
    <field name="name">Restricted Clinical Information</field>
    <field name="category_id" ref="base.module_category_sales"/>
  </record>
  <record id="group_clinical" model="res.groups">
    <field name="name">Authorized optical clinician / dispenser</field>
    <field name="privilege_id" ref="privilege_clinical"/>
    <field name="implied_ids" eval="[(4, ref('group_operator'))]"/>
  </record>
</odoo>
