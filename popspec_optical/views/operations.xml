<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="job_list" model="ir.ui.view"><field name="name">optical.job.list</field><field name="model">optical.job</field><field name="arch" type="xml">
    <list decoration-danger="overdue" decoration-muted="state == 'cancelled'"><field name="name"/><field name="patient_id"/><field name="frame_code"/><field name="state" widget="badge"/><field name="laboratory_id"/><field name="expected_date"/><field name="overdue"/><field name="activity_ids" widget="list_activity"/><field name="company_id" groups="base.group_multi_company"/></list>
  </field></record>
  <record id="job_search" model="ir.ui.view"><field name="name">optical.job.search</field><field name="model">optical.job</field><field name="arch" type="xml">
    <search><field name="name"/><field name="patient_id"/><field name="frame_id"/><field name="laboratory_id"/>
      <filter name="open" string="Open jobs" domain="[('state','not in',['dispensed','cancelled'])]"/><filter name="overdue" string="Overdue" domain="[('overdue','=',True)]"/><filter name="ready" string="Ready for collection" domain="[('state','=','ready')]"/>
      <group><filter name="by_stage" string="Stage" context="{'group_by':'state'}"/><filter name="by_lab" string="Laboratory" context="{'group_by':'laboratory_id'}"/></group>
    </search>
  </field></record>
  <record id="job_kanban" model="ir.ui.view"><field name="name">optical.job.kanban</field><field name="model">optical.job</field><field name="arch" type="xml">
    <kanban default_group_by="state" records_draggable="false" quick_create="false" group_create="false">
      <field name="name"/><field name="patient_id"/><field name="frame_code"/><field name="expected_date"/><field name="overdue"/>
      <templates><t t-name="card"><div class="d-flex justify-content-between"><strong><field name="name"/></strong><span t-if="record.overdue.raw_value" class="badge text-bg-danger">Overdue</span></div><div class="mt-2"><field name="patient_id"/></div><div class="text-muted"><field name="frame_code"/></div><div class="mt-2">Due <field name="expected_date"/></div></t></templates>
    </kanban>
  </field></record>
  <record id="job_form" model="ir.ui.view"><field name="name">optical.job.form</field><field name="model">optical.job</field><field name="arch" type="xml">
    <form string="Optical job — one pair" duplicate="false" delete="false">
      <header>
        <button name="action_scan" type="object" string="Scan job + frame" class="btn-primary"/>
        <button name="action_verify" type="object" string="Verify for lab" invisible="state != 'draft'" groups="popspec_optical.group_clinical"/>
        <button name="action_dispatch" type="object" string="Record lab dispatch" invisible="state != 'verified'"/>
        <button name="action_acknowledge" type="object" string="Record acknowledgment" invisible="state != 'in_lab' or acknowledged_at"/>
        <button name="action_receive" type="object" string="Record lab receipt" invisible="state != 'in_lab'"/>
        <button name="action_ready" type="object" string="Ready for fitting" invisible="state != 'received'" groups="popspec_optical.group_clinical"/>
        <button name="action_dispense" type="object" string="Complete dispensing" invisible="state != 'ready'" groups="popspec_optical.group_clinical"/>
        <button name="action_cancel" type="object" string="Cancel job" invisible="state in ('dispensed','cancelled')" groups="popspec_optical.group_manager" confirm="Resolve native stock, purchasing and financial documents first. Cancel this optical job?"/>
        <field name="state" widget="statusbar" statusbar_visible="draft,verified,in_lab,received,ready,dispensed"/>
      </header>
      <sheet>
        <div class="oe_button_box" name="button_box">
          <button name="action_specifications" type="object" class="oe_stat_button" icon="fa-eye" string="Restricted specifications" groups="popspec_optical.group_clinical"/>
          <button name="action_quality_check" type="object" class="oe_stat_button" icon="fa-check-square-o" string="Record quality check" groups="popspec_optical.group_clinical" invisible="state not in ('draft','received','ready')"/>
          <button name="action_lab_ticket" type="object" class="oe_stat_button" icon="fa-print" string="Restricted lab ticket" groups="popspec_optical.group_clinical" invisible="state == 'draft'"/>
        </div>
        <h1><field name="name"/></h1>
        <group><group><field name="patient_id"/><field name="sale_order_id"/><field name="sale_line_id" domain="[('order_id','=',sale_order_id)]" invisible="frame_source != 'stock'"/><field name="revision"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="expected_date"/><field name="overdue"/><field name="remake_of_id"/><field name="change_reason" placeholder="Explain this change; enter a new reason whenever editing the job."/></group></group>
        <notebook>
          <page string="Frame and stock"><group><group><field name="frame_source"/><field name="frame_id" domain="[('optical_serial','!=',False)]" invisible="frame_source != 'stock'"/><field name="frame_product_id" invisible="frame_source != 'stock'"/><field name="frame_code"/><field name="customer_frame_description" invisible="frame_source != 'customer'"/><field name="customer_frame_condition" invisible="frame_source != 'customer'"/></group><group><field name="lab_location_id" domain="[('usage','=','internal')]" invisible="frame_source != 'stock'"/><field name="reservation_picking_id" invisible="frame_source != 'stock'"/><field name="dispatch_picking_id" invisible="frame_source != 'stock'"/><field name="receipt_picking_id" invisible="frame_source != 'stock'"/><field name="delivery_picking_id" invisible="frame_source != 'stock'"/></group></group><group><field name="frame_snapshot"/></group></page>
          <page string="Laboratory"><group><group><field name="laboratory_id"/><field name="purchase_order_id" domain="[('partner_id','=',laboratory_id)]"/><field name="supplier_reference"/><field name="lab_stage"/></group><group><field name="promised_date"/><field name="acknowledged_at"/><field name="acknowledged_by"/></group></group><field name="operational_notes" placeholder="Operations only. Keep prescriptions and lens details in Restricted specifications."/></page>
          <page string="Quality history" groups="popspec_optical.group_clinical"><field name="quality_ids" readonly="1"/></page>
          <page string="SOP completion"><field name="sop_signoff_ids" readonly="1"/></page>
          <page string="Scan evidence"><field name="scan_ids" readonly="1"><list create="false" delete="false"><field name="event"/><field name="workflow_state"/><field name="revision"/><field name="code"/><field name="actor_id"/><field name="occurred_at"/></list></field></page>
          <page string="Collection and aftercare"><group><group><field name="collection_confirmed"/><field name="dispensed_by"/><field name="dispensed_at"/></group><group><field name="warranty_until"/><field name="followup_date"/></group></group><field name="case_ids" readonly="1"/></page>
          <page string="Invoices" groups="account.group_account_invoice"><field name="invoice_ids" readonly="1"/></page>
          <page string="Referral"><group><field name="source_id"/><field name="medium_id"/><field name="campaign_id"/></group></page>
          <page string="Cancellation" invisible="state != 'cancelled'"><field name="cancellation_reason"/></page>
        </notebook>
      </sheet>
    </form>
  </field></record>
<record id="sop_list" model="ir.ui.view"><field name="name">optical.sop.list</field><field name="model">optical.sop</field><field name="arch" type="xml"><list><field name="name"/><field name="step"/><field name="version"/><field name="state"/><field name="approved_by"/></list></field></record><record id="sop_form" model="ir.ui.view"><field name="name">optical.sop.form</field><field name="model">optical.sop</field><field name="arch" type="xml"><form duplicate="false"><header><button name="action_approve" type="object" string="Approve reviewed SOP" invisible="state != 'draft'" groups="popspec_optical.group_manager"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="step"/><field name="version"/><field name="instructions"/><field name="approved_by"/><field name="approved_at"/></group></sheet></form></field></record><record id="sop_signoff_list" model="ir.ui.view"><field name="name">optical.sop.signoff.list</field><field name="model">optical.sop.signoff</field><field name="arch" type="xml"><list><field name="job_id"/><field name="sop_id"/><field name="actor_id"/><field name="completed_at"/></list></field></record><record id="sop_signoff_form" model="ir.ui.view"><field name="name">optical.sop.signoff.form</field><field name="model">optical.sop.signoff</field><field name="arch" type="xml"><form duplicate="false"><sheet><group><field name="job_id"/><field name="sop_id"/><field name="notes"/><field name="actor_id"/><field name="employee_id"/><field name="completed_at"/></group></sheet></form></field></record><record id="case_list" model="ir.ui.view"><field name="name">optical.case.list</field><field name="model">optical.case</field><field name="arch" type="xml"><list><field name="name"/><field name="job_id"/><field name="kind"/><field name="responsibility"/><field name="due_date"/><field name="state"/></list></field></record><record id="case_form" model="ir.ui.view"><field name="name">optical.case.form</field><field name="model">optical.case</field><field name="arch" type="xml"><form duplicate="false"><header><button name="action_approve" type="object" string="Approve resolution" invisible="state != 'open'" groups="popspec_optical.group_manager"/><button name="action_remake" type="object" string="Create replacement job" invisible="state != 'approved' or replacement_id" groups="popspec_optical.group_manager"/><button name="action_close" type="object" string="Close resolved case" invisible="state != 'approved'" groups="popspec_optical.group_manager"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="job_id"/><field name="kind"/><field name="description"/><field name="responsibility"/><field name="due_date"/><field name="resolution"/><field name="cost_treatment"/><field name="return_picking_id"/><field name="credit_note_id" groups="account.group_account_invoice"/><field name="approved_by"/><field name="approved_at"/><field name="replacement_id"/></group></sheet></form></field></record><record id="audit_list" model="ir.ui.view"><field name="name">optical.audit.list</field><field name="model">optical.audit</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="occurred_at"/><field name="actor_id"/><field name="record_name"/><field name="action"/></list></field></record><record id="audit_form" model="ir.ui.view"><field name="name">optical.audit.form</field><field name="model">optical.audit</field><field name="arch" type="xml"><form create="false" edit="false" delete="false" duplicate="false"><sheet><group><field name="occurred_at"/><field name="actor_id"/><field name="employee_id"/><field name="model_name"/><field name="record_id"/><field name="record_name"/><field name="action"/><field name="details"/></group></sheet></form></field></record><record id="lab_ticket_list" model="ir.ui.view"><field name="name">optical.lab.ticket.list</field><field name="model">optical.lab.ticket</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="name"/><field name="job_id"/><field name="revision"/><field name="issued_by"/><field name="issued_at"/></list></field></record><record id="lab_ticket_form" model="ir.ui.view"><field name="name">optical.lab.ticket.form</field><field name="model">optical.lab.ticket</field><field name="arch" type="xml"><form create="false" edit="false" delete="false" duplicate="false"><sheet><group><field name="name"/><field name="job_id"/><field name="revision"/><field name="issued_by"/><field name="issued_at"/><field name="snapshot"/></group></sheet></form></field></record></odoo>
